
@model Sistema_Academia.Models.Aluno

@{
    ViewData["Title"] = "Excluir Aluno";

    var cpf = string.IsNullOrWhiteSpace(Model.CPF)
        ? "Não informado"
        : System.Text.RegularExpressions.Regex.Replace(
            Model.CPF, @"\D", "");

    if (cpf.Length == 11)
    {
        cpf = Convert.ToUInt64(cpf).ToString(@"000\.000\.000\-00");
    }
    else
    {
        cpf = Model.CPF ?? "Não informado";
    }

    var telefone = string.IsNullOrWhiteSpace(Model.Telefone)
        ? "Não informado"
        : System.Text.RegularExpressions.Regex.Replace(
            Model.Telefone, @"\D", "");

    if (telefone.Length == 11)
    {
        telefone = Convert.ToUInt64(telefone).ToString(@"(00) 00000-0000");
    }
    else if (telefone.Length == 10)
    {
        telefone = Convert.ToUInt64(telefone).ToString(@"(00) 0000-0000");
    }
    else
    {
        telefone = Model.Telefone ?? "Não informado";
    }
}

<h1 class="page-title">Excluir Aluno</h1>

<p class="page-description">
    Confira os dados antes de confirmar a exclusão definitiva.
</p>

<div class="form-container">

    <div class="alert-warning">
        Atenção! Este aluno será desativado, mas seus dados e
        histórico serão preservados no sistema.
    </div>

    <div class="details-grid">

        <div class="detail-item">
            <label>Nome</label>
            <strong>@Model.Nome</strong>
        </div>

        <div class="detail-item">
            <label>CPF</label>
            <strong>@cpf</strong>
        </div>

        <div class="detail-item">
            <label>E-mail</label>
            <strong>@Model.Email</strong>
        </div>

        <div class="detail-item">
            <label>Telefone</label>
            <strong>@telefone</strong>
        </div>

    </div>

    <form asp-action="Excluir" method="post">

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-actions">
            <button type="submit" class="btn-danger">
                Excluir aluno e todos os dados vinculados
            </button>

            <a asp-action="Index" class="btn-secondary">
                Cancelar
            </a>
        </div>

    </form>

</div>
