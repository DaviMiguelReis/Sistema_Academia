
@model IEnumerable<Sistema_Academia.Models.Aluno>
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = "Alunos";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Alunos</h1>
        <p class="page-description">
            Gerencie os alunos cadastrados na academia.
        </p>
    </div>

    <a asp-action="Cadastrar" class="btn-primary">
        + Novo Aluno
    </a>
</div>

<form asp-action="Index" method="get" class="search-form">

    <input type="text"
           name="pesquisa"
           class="form-control"
           placeholder="Pesquisar aluno pelo nome..."
           value="@Context.Request.Query["pesquisa"]" />

    <button type="submit" class="btn-primary">
        Pesquisar
    </button>

    <a asp-action="Index" class="btn-secondary">
        Limpar
    </a>

</form>

@if (TempData["Mensagem"] != null)
{
    <div class="alert-success">
        @TempData["Mensagem"]
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="validation-error">@TempData["Erro"]</div>
}

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>CPF</th>
                <th>E-mail</th>
                <th>Telefone</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                @foreach (var aluno in Model)
                {
                    <tr>
                        <td>@aluno.Nome</td>
                        <td>@aluno.CPF</td>
                        <td>@aluno.Email</td>
                        @{
                            var telefone = Regex.Replace(aluno.Telefone ?? string.Empty, @"\D", "");
                            var telefoneFormatado = telefone.Length == 11
                                ? $"({telefone.Substring(0, 2)}) {telefone.Substring(2, 5)}-{telefone.Substring(7, 4)}"
                                : telefone.Length == 10
                                    ? $"({telefone.Substring(0, 2)}) {telefone.Substring(2, 4)}-{telefone.Substring(6, 4)}"
                                    : (aluno.Telefone ?? "Não informado");
                        }
                        <td>@telefoneFormatado</td>

                        <td>
                            @if (aluno.Ativo)
                            {
                                <span class="status-active">Ativo</span>
                            }
                            else
                            {
                                <span class="status-inactive">Inativo</span>
                            }
                        </td>

                        <td class="actions">
                            <a asp-action="Detalhes"
                               asp-route-id="@aluno.Id"
                               class="action-link">
                                Detalhes
                            </a>

                            <a asp-action="Editar"
                               asp-route-id="@aluno.Id"
                               class="action-link">
                                Editar
                            </a>

                            <a asp-action="Excluir"
                               asp-route-id="@aluno.Id"
                               class="action-link danger">
                                Excluir
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty-message">
                        Nenhum aluno cadastrado.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
