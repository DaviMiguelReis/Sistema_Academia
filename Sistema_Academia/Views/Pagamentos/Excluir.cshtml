@model Sistema_Academia.Models.Pagamento

@{
    ViewData["Title"] = "Excluir Pagamento";
}

<h1 class="page-title">Excluir Pagamento</h1>

<p class="page-description">
    Confira as informações antes de confirmar a exclusão definitiva.
</p>

<div class="form-container">

    <div class="alert-warning">
        Tem certeza de que deseja excluir permanentemente este pagamento? Pagamentos com status Pago não podem ser excluídos.
    </div>

    <div class="details-grid">

        <div class="detail-item">
            <label>Aluno</label>
            <strong>
                @(Model.Matricula?.Aluno?.Nome ?? "Não informado")
            </strong>
        </div>

        <div class="detail-item">
            <label>Matrícula</label>
            <strong>@Model.MatriculaId</strong>
        </div>

        <div class="detail-item">
            <label>Valor</label>
            <strong>@Model.Valor.ToString("C2")</strong>
        </div>

        <div class="detail-item">
            <label>Data de vencimento</label>
            <strong>@Model.DataVencimento.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="detail-item">
            <label>Data do pagamento</label>
            <strong>@Model.DataPagamento?.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="detail-item">
            <label>Forma de pagamento</label>
            <strong>@Model.FormaPagamento</strong>
        </div>

        <div class="detail-item">
            <label>Status</label>
            <strong>@Model.Status</strong>
        </div>

    </div>

    <form asp-action="Excluir" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-actions">

            <button type="submit" class="btn-danger">
                Excluir definitivamente
            </button>

            <a asp-action="Index" class="btn-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>
