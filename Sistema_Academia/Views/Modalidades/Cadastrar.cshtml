@model Sistema_Academia.Models.Modalidade

@{
    ViewData["Title"] = "Cadastrar Modalidade";
}

<h1 class="page-title">Cadastrar Modalidade</h1>

<p class="page-description">
    Preencha os dados para cadastrar uma nova modalidade.
</p>

<div class="form-container">
    <form asp-action="Cadastrar" method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-error"></div>

        <div class="form-grid">

            <div class="form-group">
                <label asp-for="Nome">Nome da Modalidade</label>

                <input asp-for="Nome"
                       class="form-control"
                       maxlength="100"
                       placeholder="Digite o nome da modalidade" />

                <span asp-validation-for="Nome"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="CapacidadeMaxima">Capacidade</label>

                <input asp-for="CapacidadeMaxima"
                       type="number"
                       min="1"
                       step="1"
                       class="form-control"
                       placeholder="Ex.: 30" />

                <span asp-validation-for="CapacidadeMaxima"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Ativo">Situação da modalidade</label>

                <select asp-for="Ativo" class="form-control">
                    <option value="true">Ativo</option>
                    <option value="false">Inativo</option>
                </select>

                <span asp-validation-for="Ativo"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Professor">Nome do professor</label>

                <input asp-for="Professor"
                       class="form-control"
                       maxlength="150"
                       placeholder="Digite o nome do professor" />

                <span asp-validation-for="Professor"
                      class="validation-error"></span>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                Cadastrar Modalidade
            </button>

            <a asp-action="Index" class="btn-secondary">
                Cancelar
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
