@model Sistema_Academia.Models.Modalidade

@{
    ViewData["Title"] = "Editar Modalidade";
}

<h1 class="page-title">Editar Modalidade</h1>

<p class="page-description">
    Atualize as informações da modalidade.
</p>

<div class="form-container">
    <form asp-action="Editar" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="validation-error"></div>

        <div class="form-grid">

            <div class="form-group">
                <label asp-for="Nome">Nome da Modalidade</label>

                <input asp-for="Nome"
                       class="form-control"
                       maxlength="100" />

                <span asp-validation-for="Nome"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="CapacidadeMaxima">Capacidade Máxima</label>

                <input asp-for="CapacidadeMaxima"
                       type="number"
                       min="1"
                       step="1"
                       class="form-control" />

                <span asp-validation-for="CapacidadeMaxima"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Ativo">Situação da modalidade</label>

                <select asp-for="Ativo" class="form-control">
                    <option value="true">Ativo</option>
                    <option value="false">Inativo</option>
                </select>

                <span asp-validation-for="Ativo"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Professor">Nome do professor</label>

                <input asp-for="Professor"
                       class="form-control"
                       maxlength="150" />

                <span asp-validation-for="Professor"
                      class="validation-error"></span>
            </div>

            <div class="form-group full-width">
                <label asp-for="Descricao">Descrição</label>

                <textarea asp-for="Descricao"
                          class="form-control"
                          maxlength="300"
                          rows="4"></textarea>

                <span asp-validation-for="Descricao"
                      class="validation-error"></span>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                Salvar Alterações
            </button>

            <a asp-action="Index" class="btn-secondary">
                Cancelar
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
