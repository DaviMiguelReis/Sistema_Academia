
@model Sistema_Academia.Models.Plano

@{
    ViewData["Title"] = "Cadastrar Plano";
}

<h1 class="page-title">Cadastrar Plano</h1>

<p class="page-description">
    Preencha os dados para cadastrar um novo plano na academia.
</p>

<div class="form-container">

    <form asp-action="Cadastrar" method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-error"></div>

        <div class="form-grid">

            <div class="form-group">
                <label asp-for="Nome">Nome do plano</label>
                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Ex.: Plano Mensal" />

                <span asp-validation-for="Nome"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Valor">Valor (R$)</label>
                <input asp-for="Valor"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control"
                       placeholder="Ex.: 99.90" />

                <span asp-validation-for="Valor"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DuracaoMeses">Duração (meses)</label>
                <input asp-for="DuracaoMeses"
                       type="number"
                       min="1"
                       step="1"
                       class="form-control"
                       placeholder="Ex.: 3" />

                <span asp-validation-for="DuracaoMeses"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Ativo">Situação do plano</label>

                <select asp-for="Ativo" class="form-control">
                    <option value="true">Ativo</option>
                    <option value="false">Inativo</option>
                </select>

                <span asp-validation-for="Ativo"
                      class="validation-error"></span>
            </div>

            <div class="form-group full-width">
                <label asp-for="Descricao">Descrição</label>

                <textarea asp-for="Descricao"
                          class="form-control"
                          rows="4"
                          placeholder="Descreva os benefícios e características do plano..."></textarea>

                <span asp-validation-for="Descricao"
                      class="validation-error"></span>
            </div>

        </div>

        <div class="form-actions">

            <button type="submit" class="btn-primary">
                Cadastrar Plano
            </button>

            <a asp-action="Index" class="btn-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
